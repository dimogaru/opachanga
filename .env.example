# App
PORT=3000
DB_PATH=./data/o-pachanga.sqlite
SESSION_SECRET=replace-with-a-long-random-value
INITIAL_ADMIN_PASSWORD=

# Web Push: puedes usar VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY o los alias indicados debajo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain
# Alias compatibles: PUBLIC_VAPID_KEY, PRIVATE_VAPID_KEY, VAPID_EMAIL
PUBLIC_VAPID_KEY=
PRIVATE_VAPID_KEY=
VAPID_EMAIL=
